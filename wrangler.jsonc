{
  // Cloudflare Workers deployment — static assets only, no worker script.
  // Worker name "bot" keeps the existing public URL alive:
  //   https://bot.b4ndxutility.workers.dev/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
